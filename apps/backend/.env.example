# Backend only. Load with: uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
# Use ONE worker while sessions and uploads use the in-memory repository.

# All providers may be configured simultaneously. Legacy default: DashScope first.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# DeepSeek official API: independent URL/key/model, even when DashScope is configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Zhipu mainland open platform. Do not use another region/platform's credentials here.
# Both key and an explicit model are required; arbitrary versions are accepted for Chat.
# Unknown models require explicit capabilities in AI_MODEL_REGISTRY_FILE for Agent use.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=

# AutoDL OpenAI-compatible gateway. Backend only; an empty key registers no AutoDL models.
AUTODL_API_KEY=
AUTODL_BASE_URL=https://www.autodl.art/api/v1
# Comma-separated exact upstream IDs (case-sensitive); blank uses the verified priority list:
# DeepSeek-V4.1-Flash-1017,Qwen3.5-397B-A17B,Kimi-K2.5
# Unknown IDs have conservative Chat capabilities and cannot be used by Agent.
AUTODL_MODELS=

# Optional legacy extra models: bound to DashScope if its key exists, otherwise DeepSeek.
# For multi-provider catalogs use the declarative file below instead.
# Raw legacy IDs remain aliases; new sessions persist provider-qualified IDs.
AI_ALLOWED_MODELS=
AI_TIMEOUT_SEC=90
# Explicit registry ID (e.g. dashscope/qwen-plus or zhipu/glm-4-plus).
# Raw registered aliases are accepted too. Invalid defaults fail configuration validation.
AI_DEFAULT_MODEL=
AI_AGENT_DEFAULT_MODEL=
# Recommended when AutoDL is enabled (uncomment to explicitly select):
# AI_DEFAULT_MODEL=autodl/DeepSeek-V4.1-Flash-1017
# AI_AGENT_DEFAULT_MODEL=autodl/DeepSeek-V4.1-Flash-1017
# Optional server-only JSON definitions; no literal keys in this file.
# Relative paths resolve from the backend process working directory.
# See docs/engineering/llm-api-foundation.md for the schema and precedence.
AI_MODEL_REGISTRY_FILE=

# Optional web search: Tavily first, SearXNG fallback. Both unavailable -> visible warning.
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# Optional Agent image search; an empty key leaves this tool unavailable.
EXA_API_KEY=
# Agent Skill discovery: empty enables all vendor skills; none disables vendor skills.
SKILLS_VENDOR=
# Optional: disable provider thinking extensions for compatible reasoning models.
AGENT_DISABLE_THINKING=false

# External Research Capability integration (Search -> Paper Detail -> Graph).
# Keep the upstream service address server-side; never expose it to the browser.
KNOWLEDGE_BASE_API_URL=
KNOWLEDGE_BASE_TIMEOUT_SEC=30
# Maximum result window accepted by the upstream retrieval search endpoint.
KNOWLEDGE_BASE_SEARCH_MAX_TOP_K=100

# PDF preflight and transient streaming only. Files are never persisted or cached.
PAPER_RESOURCE_TIMEOUT=30
PAPER_MAX_SIZE_MB=150
OPENREVIEW_API_BASE_URL=https://api2.openreview.net
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Same server-to-server secret in Web; never NEXT_PUBLIC_. Required by default and on all non-loopback deployments.
BACKEND_BFF_SECRET=
# Explicit development-only escape hatch. Both Web and Backend must set this to true,
# and BUSINESS_BACKEND_URL / the caller must be loopback. Never enable in production.
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# Optional: PostgreSQL for durable Backend data (Chat sessions and paper reading history).
# This is separate from the Web Auth DB.
# Vercel Serverless 部署必须配置,否则会话存于函数内存,多实例下丢失。
# 使用 Vercel Postgres (Neon) 时,在同一实例为 Chat 建独立库并粘贴 pooled 连接串。
# 注意:asyncpg 不接受 Neon 连接串中的 channel_binding/sslmode 参数,
# 需将 ?channel_binding=require&sslmode=require 改写为 ?ssl=require 再配置。
#  部署好环境后，执行该命令行来建表：uv run --env-file .env alembic -c alembic.ini upgrade head
# CHAT_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/shenzhi_chat


# Anonymous cookie/data retention, in seconds. Keep equal to apps/web.
CHAT_ANONYMOUS_TTL_SECONDS=604800
