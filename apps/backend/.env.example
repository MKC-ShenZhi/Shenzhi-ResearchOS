# Backend only. Load with: uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
# Use ONE worker while sessions and uploads use the in-memory repository.

# External Research Capability integration (Search -> Paper Detail -> Graph).
# Keep the upstream service address server-side; never expose it to the browser.
KNOWLEDGE_BASE_API_URL=
KNOWLEDGE_BASE_TIMEOUT_SEC=30
# Maximum result window accepted by the upstream retrieval search endpoint.
KNOWLEDGE_BASE_SEARCH_MAX_TOP_K=100

# PDF preflight and transient streaming only. Files are never persisted or cached.
PAPER_RESOURCE_TIMEOUT=30
PAPER_MAX_SIZE_MB=150
OPENREVIEW_API_BASE_URL=https://api2.openreview.net
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# Same server-to-server secret in Web; never NEXT_PUBLIC_. Required by default and on all non-loopback deployments.
BACKEND_BFF_SECRET=
# Explicit development-only escape hatch. Both Web and Backend must set this to true,
# and BUSINESS_BACKEND_URL / the caller must be loopback. Never enable in production.
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# Read-only platform statistics used by the Knowledge Base daily sync.
# A service identity, deliberately separate from BACKEND_BFF_SECRET and every
# user session: it can only read /api/v1/stats/* aggregates.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATS_SERVICE_TOKEN=

# Optional: Bearer secret for GET /api/v1/internal/recommendation-maintenance (expired
# behavior events and recommendation snapshots). With HOME_FEED_SCHEDULER_ENABLED the
# in-process scheduler already runs this hourly; the endpoint and the CLI
# `python -m app.services.recommendation.maintenance` are for external or manual runs.
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# Optional: PostgreSQL for durable Backend data (Agent sessions, uploads, library, recommendations ...).
# This is separate from the Web Auth DB.
# Vercel Serverless 部署必须配置,否则会话存于函数内存,多实例下丢失。
# 使用 Vercel Postgres (Neon) 时,在同一实例为业务后端建独立库并粘贴 pooled 连接串。
# 注意:asyncpg 不接受 Neon 连接串中的 channel_binding/sslmode 参数,
# 需将 ?channel_binding=require&sslmode=require 改写为 ?ssl=require 再配置。
#  部署好环境后，执行该命令行来建表：uv run --env-file .env alembic -c alembic.ini upgrade head
# CHAT_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/shenzhi_chat


# 首页数据源：API 进程内定时同步候选池、生成每日候选、清理过期推荐快照与行为事件（多实例经 advisory lock 只执行一次）
# HOME_FEED_SCHEDULER_ENABLED=true
# 候选池年份，默认 2026
# HOME_FEED_POOL_YEAR=2026

# Conference sync uses HomeFeedScheduler in a long-running backend only.
# Poll every 10 minutes; check upstream when due; retry failures after >= 1 hour.
# Independent from HOME_FEED_SCHEDULER_ENABLED; no Actions/Vercel Cron required.
CONFERENCE_SYNC_ENABLED=false

# Optional read-only GitHub token for shared-IP API rate limits; backend only.
CONFERENCE_GITHUB_TOKEN=

# Agent service, accessed only by Backend over the private network.
AGENT_INTERNAL_URL=http://127.0.0.1:8101
AGENT_SERVICE_TOKEN=
