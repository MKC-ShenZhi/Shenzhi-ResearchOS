# Backend only. Load with: uvicorn app.main:app --env-file .env --host 127.0.0.1 --port 8000
# Use ONE worker while sessions and uploads use the in-memory repository.

# DashScope takes precedence when its key is nonblank.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Used when DASHSCOPE_API_KEY is absent. DeepSeek defaults never use the DashScope URL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional comma-separated models offered IN ADDITION to the provider's default model.
# Only list models supported by the selected provider, e.g. deepseek-reasoner.
AI_ALLOWED_MODELS=
AI_TIMEOUT_SEC=90

# Optional web search: Tavily first, SearXNG fallback. Both unavailable -> visible warning.
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# Existing paper retrieval service. Empty disables the legacy /search/explore path.
RETRIEVAL_API_URL=
RETRIEVAL_TIMEOUT_SEC=30

# External Research Capability integration (Search -> Paper Detail -> Graph).
# Keep the upstream service address server-side; never expose it to the browser.
KNOWLEDGE_BASE_API_URL=
KNOWLEDGE_BASE_TIMEOUT_SEC=30

# Same server-to-server secret in Web; never NEXT_PUBLIC_. Required by default and on all non-loopback deployments.
BACKEND_BFF_SECRET=
# Explicit development-only escape hatch. Both Web and Backend must set this to true,
# and BUSINESS_BACKEND_URL / the caller must be loopback. Never enable in production.
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# Optional: PostgreSQL for durable Chat sessions (separate from Web Auth DB).
# When set, run migrations first: uv run alembic -c alembic.ini upgrade head
# CHAT_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/shenzhi_chat

# Anonymous cookie/data retention, in seconds. Keep equal to apps/web.
CHAT_ANONYMOUS_TTL_SECONDS=604800
