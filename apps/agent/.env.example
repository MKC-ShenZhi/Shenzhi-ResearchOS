# Agent-owned PostgreSQL database; use a separate database from Backend.
AGENT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<agent_db>

# Independent Backend-to-Agent and Worker-to-Agent service credential.
AGENT_SERVICE_TOKEN=<long-random-service-token>
AGENT_INTERNAL_URL=http://127.0.0.1:8101
# API and Worker hosts must see the same durable/shared workspace volume.
AGENT_WORKSPACE_ROOT=./workspace
# Backend-owned Knowledge API adapter; never configure Knowledge credentials here.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1/agent

# Agent Provider credentials are configured only in the Agent runtime environment.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
AUTODL_API_KEY=
AI_ALLOWED_MODELS=
AI_DEFAULT_MODEL=
AI_AGENT_DEFAULT_MODEL=
AI_MODEL_REGISTRY_FILE=
AI_TIMEOUT_SEC=90
TAVILY_API_KEY=
SEARXNG_BASE_URL=
EXA_API_KEY=
SKILLS_VENDOR=
AGENT_DISABLE_THINKING=false
