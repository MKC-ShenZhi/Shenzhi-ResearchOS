# Agent-owned PostgreSQL database; use a separate database from Backend.
AGENT_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<agent_db>

# Independent Backend-to-Agent and Worker-to-Agent service credential.
AGENT_SERVICE_TOKEN=<long-random-service-token>
AGENT_INTERNAL_URL=http://127.0.0.1:8101
# API and Worker hosts must see the same durable/shared workspace volume.
AGENT_WORKSPACE_ROOT=./workspace
# Local acceptance only. Requires explicit python -m agent_app.demo_worker.
# Prefer scripts/agent_m1_demo.py, which enforces the isolated acceptance DBs.
AGENT_DEMO_MODE=0
# Backend-owned Knowledge API adapter; never configure Knowledge credentials here.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api/v1/agent

# Agent Provider credentials are configured only in the Agent runtime environment.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
AUTODL_API_KEY=
# Docker: configure the env_file consumed by Agent containers, locally
# infra/docker/env/agent.env. apps/agent/.env is for non-container launches.
OPENLUX_API_KEY=
OPENLUX_BASE_URL=
# Exact upstream IDs, comma-separated; empty means no OpenLux registration.
OPENLUX_MODELS=
# Subset of OPENLUX_MODELS verified for streaming + multi-turn tool calling.
# Empty keeps OpenLux models out of the Agent menu. No capabilities are inferred.
OPENLUX_AGENT_MODELS=
# Optional overrides. Uncomment to replace the built-in values.
# DASHSCOPE_BASE_URL=<DASHSCOPE_BASE_URL>
# DASHSCOPE_MODEL=qwen-plus
# DEEPSEEK_BASE_URL=<DEEPSEEK_BASE_URL>
# DEEPSEEK_MODEL=deepseek-chat
# ZHIPU_BASE_URL=<ZHIPU_BASE_URL>
# ZHIPU_MODEL=
# AUTODL_BASE_URL=<AUTODL_BASE_URL>
# AUTODL_MODELS accepts comma-separated exact upstream model IDs.
AUTODL_MODELS=
AI_ALLOWED_MODELS=
AI_DEFAULT_MODEL=
AI_AGENT_DEFAULT_MODEL=
AI_MODEL_REGISTRY_FILE=
AI_TIMEOUT_SEC=90
TAVILY_API_KEY=
SEARXNG_BASE_URL=
EXA_API_KEY=
SKILLS_VENDOR=
AGENT_DISABLE_THINKING=false

# V2 candidate protocol: disabled until contract/policy/deployment review.
# Keep v1 draining on separate Workers when authorized admission is enabled.
# After approval: set drain_only and start separate protocol=2 Workers.
AGENT_V1_ADMISSION=legacy
AGENT_WORKER_PROTOCOL=1
AGENT_AUDIENCE=
AGENT_GRANT_ISSUER=
AGENT_GATEWAY_TOKEN=
AGENT_FACT_READER_TOKEN=
AGENT_WORKER_TOKEN=
AGENT_CONTROL_TOKEN=
# Separate origin, without /api/v1/agent (Knowledge retains BACKEND_INTERNAL_URL).
BACKEND_ENTITLEMENTS_URL=<BACKEND_ORIGIN>
# Local JSON: kid -> Ed25519 PEM public key; retain historical verification keys.
AGENT_GRANT_PUBLIC_KEYS_FILE=
AGENT_MODEL_ROUTE_REVISION=
AGENT_TOOL_CONFIGURATION_RELEASE=
# Persistent Worker-only volume, independent of ephemeral process storage.
AGENT_USAGE_SPOOL_ROOT=
# Operations must explicitly choose these values; blank means unavailable.
AGENT_USAGE_OUTBOX_CAPACITY=
AGENT_USAGE_BATCH_SIZE=
AGENT_USAGE_MAX_ATTEMPTS=
AGENT_USAGE_RETRY_BASE_SECONDS=
AGENT_USAGE_RETRY_MAX_SECONDS=
AGENT_USAGE_POLL_SECONDS=
