# =================================
# ShenZhi Web / Better Auth
# =================================

# FastAPI 业务后端（仅服务端，不要 NEXT_PUBLIC_）。浏览器只请求同源 /api/v1。
# 示例:http://127.0.0.1:8000
# BUSINESS_BACKEND_URL=
# 兼容旧名（同样仅服务端）:
# API_URL=

# Knowledge Client 来源：正式运行默认走同源 Next.js BFF；仅在显式开发/测试/demo 时设为 mock。
NEXT_PUBLIC_KNOWLEDGE_SOURCE=bff

# Better Auth 服务端秘密,用于加密与签名;禁止使用 NEXT_PUBLIC_ 前缀。
# 使用高熵随机值,至少 32 个字符;真实 secret 不提交 Git。
BETTER_AUTH_SECRET=

# Better Auth 应用基础地址;本地开发可填写 http://localhost:3000。
BETTER_AUTH_URL=

# 可选:逗号分隔的正式前端/管理端 origin,不要写空字符串项。
BETTER_AUTH_TRUSTED_ORIGINS=

# =================================
# Authentication Database
# =================================

# PostgreSQL 连接地址,供 Better Auth 使用。
DATABASE_URL=

# =================================
# Email Provider
# =================================

# 当前 Provider: Alibaba Cloud DirectMail。
# 未配置完整前应用仍可启动,实际邮件发送请求会安全失败。
EMAIL_PROVIDER=aliyun-directmail

# 仅从 Deployment Secrets 注入,不得提交到 Git。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 显式填写与发信地址所在区域匹配的 DirectMail 区域和 endpoint。
ALIYUN_DIRECTMAIL_REGION_ID=
ALIYUN_DIRECTMAIL_ENDPOINT=

# 必须是在 DirectMail 控制台完成验证的发信地址。
AUTH_EMAIL_FROM=
# 可选: DirectMail FromAlias,由阿里云限制长度。
AUTH_EMAIL_FROM_ALIAS=

# =================================
# GitHub OAuth
# =================================

# GitHub OAuth App 的 Client ID 与 Client Secret。
# 未配置完整前应用仍可启动,点击 GitHub 登录时 Better Auth 会返回 Provider 未配置错误。
# 在 GitHub → Settings → Developer settings → OAuth Apps 创建应用,
# 授权回调地址填写:<BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=Ov23liRj7QcoNg0nXuvV
GITHUB_CLIENT_SECRET=

# =================================
# Cloudflare Turnstile (人机验证)
# =================================

# 是否启用发送验证码前的人机验证;启用后必须同时配置下面两个密钥。
TURNSTILE_ENABLED=false

# 站点密钥(公开,用于前端渲染人机验证组件),必须使用 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAERAO4B7tzQyfJPT

# 站点密钥对应的 Secret(仅服务端,用于校验 token),不得提交到 Git。
TURNSTILE_SECRET_KEY=

# 可选:限制 token 的 action 与允许的 hostname,留空表示不限制。
TURNSTILE_EXPECTED_ACTION=
TURNSTILE_ALLOWED_HOSTNAMES=

# =================================
# Business Backend
# =================================

# FastAPI 根地址,不暴露给浏览器。本地默认:http://127.0.0.1:8000
BUSINESS_BACKEND_URL=

# 论文检索服务由 apps/backend 通过 RETRIEVAL_API_URL 调用，Web 侧无需配置。

# BFF -> FastAPI internal credential. Same value in backend; never NEXT_PUBLIC_.
BACKEND_BFF_SECRET=
# Development only: permit a missing secret when BUSINESS_BACKEND_URL is loopback.
# The Backend must set the same flag; never enable this in production.
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# Anonymous Chat cookie and durable anonymous-session retention, in seconds.
# Keep this equal to the Backend value. Default: 604800 (7 days).
CHAT_ANONYMOUS_TTL_SECONDS=604800
