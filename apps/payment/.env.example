WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_FILE=/run/secrets/payment/wechat-private.pem
WECHAT_NOTIFY_URL=https://<PUBLIC_WEB_HOST>/api/payment-notifications/wechat
