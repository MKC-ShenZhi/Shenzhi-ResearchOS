# Compose 插值配置，不会自动注入所有应用；应用秘密放 env/*.env。
# prepare-env.py 自动生成内部凭据和数据库连接；外部服务与授权配置需自行填写。

# ---- 项目与数据库初始化 ----
# 项目名决定 named volume 归属，改名后会使用另一组卷。
COMPOSE_PROJECT_NAME=shenzhi-docker
# PostgreSQL 初始化用户名；生成 DSN 要求仅含字母、数字、_ 或 -。
POSTGRES_USER=shenzhi
# 初始化密码，留空由脚本随机生成；已有卷修改此项不会自动修改数据库角色密码。
POSTGRES_PASSWORD=
# 业务库名；与 AGENT_DB 必须不同，仅含字母、数字、_ 或 -；已有卷不会因改名自动建库。
POSTGRES_DB=shenzhi
# 独立 Agent 库名；同上，已有卷新增库需显式操作。
AGENT_DB=shenzhi_agent

# ---- 宿主端口 ----
# 宿主 loopback 的数据库端口；生产 override 不发布数据库端口。
POSTGRES_PORT=55432
# 宿主 loopback 的 Web 端口；修改后同步 web.env 的 BETTER_AUTH_URL / TRUSTED_ORIGINS。
WEB_PORT=3300
# 开发 override 的 Backend 宿主 loopback 端口；生产不发布。
BACKEND_PORT=8800
# 开发 override 的 Agent API 宿主 loopback 端口；生产不发布。
AGENT_PORT=8811

# ---- 镜像版本 ----
# 镜像仓库前缀，生产填写已审核的镜像仓库。
IMAGE_PREFIX=shenzhi
# 镜像版本；生产使用唯一版本标签。
IMAGE_TAG=local

# ---- Web 生产构建参数（与 web.env 同步，修改需重建） ----
# 知识库数据来源，正常运行保持 bff；仅显式开发/测试/demo 使用 mock。
NEXT_PUBLIC_KNOWLEDGE_SOURCE=bff
# 知识库搜索缩略图开关，不影响首页静态缩略图。
NEXT_PUBLIC_PAPER_THUMBNAIL_ENABLED=false
# Turnstile 公开站点密钥，启用人机验证时填写；不能填服务端 Secret。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
