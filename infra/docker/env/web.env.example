# web 容器配置：真实值只填本地 web.env，不得提交。
# prepare-env.py 自动生成内部凭据和数据库连接；外部服务与授权配置需自行填写。
# Compose 使用 raw env_file：值不加外层引号，备注单独占行。
# 修改后重新创建对应容器；restart 不重新读取环境文件，命令见 ../README.md。
# 容器内 localhost 指向容器自身；宿主服务使用容器可达地址，详见 ../README.md。
# NEXT_PUBLIC_* 生产构建时内联；须同步 ../.env 同名参数并重建 Web 镜像。

# ---- Web → FastAPI ----
# Web 服务端调用 FastAPI 的根地址；浏览器仍走同源 /api/v1，容器间使用服务名。
BUSINESS_BACKEND_URL=http://backend:8000
# Web → Backend 内部凭据，脚本生成；web.env 与 backend.env 同名项必须一致。
BACKEND_BFF_SECRET=
# 仅本机 loopback 可用的免密旁路；跨容器及生产保持 false。
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# ---- 认证与数据库 ----
# Better Auth 的 PostgreSQL DSN，脚本生成；与 Backend 指向同一业务库。
DATABASE_URL=
# 认证加密/签名秘密，至少 32 字符；脚本生成，不随重启轮换。
BETTER_AUTH_SECRET=
# 浏览器实际访问的站点地址；改 WEB_PORT 或正式域名时同步修改。
BETTER_AUTH_URL=http://localhost:3300
# 允许的 origin，逗号分隔，不带路径；按实际访问地址配置。
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3300

# ---- 阿里云 DirectMail ----
# 当前邮件 Provider；未完整配置 DirectMail 时实际发信失败。
EMAIL_PROVIDER=aliyun-directmail
# 阿里云访问凭据 ID，仅服务端发信使用。
ALIBABA_CLOUD_ACCESS_KEY_ID=
# 阿里云访问凭据 Secret，不得提交或放入 NEXT_PUBLIC_ 变量。
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 发信地址所在的 DirectMail 区域，须与 endpoint 匹配。
ALIYUN_DIRECTMAIL_REGION_ID=
# 对应区域的 DirectMail endpoint，按实际服务配置。
ALIYUN_DIRECTMAIL_ENDPOINT=
# 已在 DirectMail 完成验证的发信地址。
AUTH_EMAIL_FROM=
# 可选发件人别名，受 DirectMail 长度限制；可留空。
AUTH_EMAIL_FROM_ALIAS=

# ---- GitHub OAuth ----
# 可选 GitHub OAuth App ID；未配完整时 GitHub 登录不可用。
GITHUB_CLIENT_ID=
# OAuth App Secret；回调地址为 <BETTER_AUTH_URL>/api/auth/callback/github。
GITHUB_CLIENT_SECRET=

# ---- Cloudflare Turnstile ----
# 发送验证码前的人机验证开关；启用须同时配置服务端 Secret 和公开 Site Key。
TURNSTILE_ENABLED=false
# Turnstile 服务端 token 校验密钥，不得使用 NEXT_PUBLIC_ 前缀。
TURNSTILE_SECRET_KEY=
# 可选：限制 token 的 action，留空不限制。
TURNSTILE_EXPECTED_ACTION=
# 可选：允许的 hostname，逗号分隔；留空不限制。
TURNSTILE_ALLOWED_HOSTNAMES=

# ---- 浏览器公开配置（生产构建时内联） ----
# 知识库数据来源，正常运行保持 bff；仅显式开发/测试/demo 使用 mock。
NEXT_PUBLIC_KNOWLEDGE_SOURCE=bff
# 知识库搜索缩略图开关，不影响首页静态缩略图。
NEXT_PUBLIC_PAPER_THUMBNAIL_ENABLED=false
# Turnstile 公开站点密钥，启用人机验证时填写；不能填服务端 Secret。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- 服务端图片代理 ----
# 知识底座上游地址，仅服务端可用；真实地址只填本地 env。Web 图片代理与 Backend 保持一致，关闭搜索缩略图时 Web 可留空。
KNOWLEDGE_BASE_API_URL=
# 知识底座请求超时（秒）；Web 图片代理包含响应头和内容读取。
KNOWLEDGE_BASE_TIMEOUT_SEC=30
