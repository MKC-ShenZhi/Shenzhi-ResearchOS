# backend 容器配置：真实值只填本地 backend.env，不得提交。
# prepare-env.py 自动生成内部凭据和数据库连接；外部服务与授权配置需自行填写。
# Compose 使用 raw env_file：值不加外层引号，备注单独占行。
# 修改后重新创建对应容器；restart 不重新读取环境文件，命令见 ../README.md。
# 容器内 localhost 指向容器自身；宿主服务使用容器可达地址，详见 ../README.md。

# ---- 运行环境与 BFF ----
# 运行环境标识；生产 compose.prod.yml 覆盖为 production。
ENVIRONMENT=development
# 业务 PostgreSQL DSN，脚本生成；与 Web DATABASE_URL 同库，与 Agent 分库。
CHAT_DATABASE_URL=
# Web → Backend 内部凭据，脚本生成；web.env 与 backend.env 同名项必须一致。
BACKEND_BFF_SECRET=
# 仅本机 loopback 可用的免密旁路；跨容器及生产保持 false。
BACKEND_ALLOW_INSECURE_LOCAL_BFF=false

# ---- 知识底座与论文资源 ----
# 知识底座上游地址，仅服务端可用；真实地址只填本地 env。Web 图片代理与 Backend 保持一致，关闭搜索缩略图时 Web 可留空。
KNOWLEDGE_BASE_API_URL=
# 知识底座请求超时（秒）；Web 图片代理包含响应头和内容读取。
KNOWLEDGE_BASE_TIMEOUT_SEC=30
# 论文 PDF 预检及临时流式转发超时（秒），不做持久缓存。
PAPER_RESOURCE_TIMEOUT=30
# 允许转发的论文资源大小上限（MB）。
PAPER_MAX_SIZE_MB=150
# 可选：需认证的 OpenReview 资源所用账号。
OPENREVIEW_USERNAME=
# 对应 OpenReview 密码，仅本地保存。
OPENREVIEW_PASSWORD=

# ---- 后台调度与独立服务凭据 ----
# 首页数据、推荐清理和会议同步调度；默认关闭，按需只在单个常驻 Backend 开启。
BACKGROUND_JOBS_ENABLED=false
# 可选：会议同步只读访问 GitHub 的 Token，用于缓解共享 IP 限流。
CONFERENCE_GITHUB_TOKEN=
# 知识底座读取 /api/v1/stats/* 聚合统计的独立凭据，不复用 BFF 或用户凭据。
STATS_SERVICE_TOKEN=
# 可选：外部调用推荐清理接口的 Bearer 凭据；进程内调度不依赖此项。
CRON_SECRET=

# ---- Agent 内部服务 ----
# Agent API 地址，Backend / Worker 使用 Compose 服务名访问。
AGENT_INTERNAL_URL=http://agent-api:8101
# V1 内部服务凭据，脚本生成；Backend 与 Agent 同名项必须一致。
AGENT_SERVICE_TOKEN=

# ---- V2 授权 ----
# 默认 disabled；authorized 为正式授权，observation_only 仅用于经批准的观测流程。启用还需签名、Policy/权益、隔离角色凭据及 Usage Worker，详见 docs/agent/entitlements.md。
AGENT_V2_ADMISSION=disabled
# 观测准入批准修订号，仅 observation_only 使用；默认留空。
AGENT_OBSERVATION_ADMISSION_REVISION=
# 授权目标 audience，Backend 与 Agent 同名项必须一致。
AGENT_AUDIENCE=shenzhi-docker
# 授权签发者，Backend 与 Agent 同名项必须一致。
AGENT_GRANT_ISSUER=shenzhi-backend
# V2 Gateway 角色凭据，脚本生成；Backend / Agent 同名项一致，不与其他角色或 V1 凭据复用。
AGENT_GATEWAY_TOKEN=
# V2 事实读取角色凭据，脚本生成；Backend / Agent 同名项一致，角色间保持隔离。
AGENT_FACT_READER_TOKEN=
# V2 Control 角色凭据，脚本生成；Backend / Agent 同名项一致，角色间保持隔离。
AGENT_CONTROL_TOKEN=
# Ed25519 私钥的容器路径，通常 /run/secrets/backend/grant-private.pem；本机文件放 secrets/backend/，脚本可导入但不生成签名密钥。
AGENT_GRANT_PRIVATE_KEY_FILE=
# 当前签名 key ID，须对应 Agent 公钥 JSON 中的 kid。
AGENT_GRANT_SIGNING_KID=
# 仅显式 development 可允许已分配的 test_only Policy；不跳过身份、权益、预算和签名。生产保持 false。
AGENT_ALLOW_TEST_POLICY=false

# ---- Admin 入口隔离 ----
# 保持 local-only；Compose 不提供 Admin，容器私网不等于可信隧道。SSH 隧道免密码尚未实现，不可关闭本项绕过认证，见 deployment.md。
ADMIN_AUTH_LOCAL_ONLY=true
