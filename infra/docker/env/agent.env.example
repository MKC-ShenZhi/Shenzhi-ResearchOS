# agent 容器配置：真实值只填本地 agent.env，不得提交。
# prepare-env.py 自动生成内部凭据和数据库连接；外部服务与授权配置需自行填写。
# Compose 使用 raw env_file：值不加外层引号，备注单独占行。
# 修改后重新创建对应容器；restart 不重新读取环境文件，命令见 ../README.md。
# 容器内 localhost 指向容器自身；宿主服务使用容器可达地址，详见 ../README.md。
# Agent API、执行 Worker、Usage Worker 共用此文件，修改后需一起重新创建。

# ---- 数据库、内部服务与持久目录 ----
# 独立 Agent PostgreSQL DSN（postgresql+asyncpg://），脚本生成，不与业务库混用。
AGENT_DATABASE_URL=
# Agent API 地址，Backend / Worker 使用 Compose 服务名访问。
AGENT_INTERNAL_URL=http://agent-api:8101
# Agent 访问 Backend 的知识适配接口，不直接连接知识底座上游；此地址带 /api/v1/agent。
BACKEND_INTERNAL_URL=http://backend:8000/api/v1/agent
# 用量/权益回传使用的 Backend 根地址，不带 /api/v1/agent。
BACKEND_ENTITLEMENTS_URL=http://backend:8000
# V1 内部服务凭据，脚本生成；Backend 与 Agent 同名项必须一致。
AGENT_SERVICE_TOKEN=
# API 与执行 Worker 共用的持久工作区，Compose 已挂载 named volume。
AGENT_WORKSPACE_ROOT=/var/lib/shenzhi/workspace
# 用量恢复 Spool 持久目录，使用独立 named volume；重建容器时保留。
AGENT_USAGE_SPOOL_ROOT=/var/lib/shenzhi/usage-spool
# 正常运行保持 0；隔离 demo 另有专用验收入口。
AGENT_DEMO_MODE=0

# ---- V1 / V2 协议与授权 ----
# V1 默认 legacy；Backend 开启 V2 时设 drain_only，停止新 V1 准入并排空存量。
AGENT_V1_ADMISSION=legacy
# 默认 V1 Worker 使用 1；V2 使用 2，切换需按部署约定处理存量任务。
AGENT_WORKER_PROTOCOL=1
# 授权目标 audience，Backend 与 Agent 同名项必须一致。
AGENT_AUDIENCE=shenzhi-docker
# 授权签发者，Backend 与 Agent 同名项必须一致。
AGENT_GRANT_ISSUER=shenzhi-backend
# V2 Gateway 角色凭据，脚本生成；Backend / Agent 同名项一致，不与其他角色或 V1 凭据复用。
AGENT_GATEWAY_TOKEN=
# V2 事实读取角色凭据，脚本生成；Backend / Agent 同名项一致，角色间保持隔离。
AGENT_FACT_READER_TOKEN=
# V2 Control 角色凭据，脚本生成；Backend / Agent 同名项一致，角色间保持隔离。
AGENT_CONTROL_TOKEN=
# V2 Worker → Agent 凭据，脚本生成；与其他角色及 V1 凭据不同。
AGENT_WORKER_TOKEN=
# Optional Phase 1 read-only Agent management credential. Match only Agent API and Backend.
AGENT_MANAGEMENT_TOKEN=
# Agent API only. JSON object maps each deployed Worker ID to the SHA-256 digest of its own report token.
AGENT_WORKER_REPORT_IDENTITIES=
# Worker only. Set a stable AGENT_WORKER_ID and a unique random report token for each instance.
AGENT_WORKER_REPORT_TOKEN=
AGENT_WORKER_ID=
AGENT_WORKER_REPORT_INTERVAL_SECONDS=15
AGENT_WORKER_STALE_SECONDS=45
AGENT_WORKER_OFFLINE_SECONDS=90
AGENT_WORKER_REPORT_RETENTION_DAYS=7
# Agent API only. JSON object of Provider ID to dedicated diagnostic credential.
AGENT_HEALTHCHECK_PROVIDER_KEYS=
AGENT_CONFIG_REVISION=
# Phase 3 is disabled by default. off | shadow | enforce
AGENT_CONFIG_WRITE_ENABLED=false
AGENT_CONFIG_REQUIRE_SEPARATE_APPROVAL=true
AGENT_CONFIG_APPROVER_PUBLIC_KEYS={}
AGENT_MANAGEMENT_INSPECTOR_ENABLED=false
AGENT_CONFIG_TOOL_METADATA_ROOT=
AGENT_CONFIG_SCHEDULING=off
AGENT_CONFIG_MANAGEMENT_TOKEN=
AGENT_CONFIG_VALIDATOR_SECRET=
AGENT_CONFIG_WORKER_ROLE=
AGENT_EXECUTION_CONFIG_FILE=
AGENT_CONFIG_SKILL_ARTIFACT_ROOT=
AGENT_CONFIG_PROVIDER_ORIGINS=
AGENT_CONFIG_SECRET_REFS=
AGENT_CONFIG_ATTEST_NETWORK=false
# 公钥 JSON 的容器路径，格式为 kid → Ed25519 PEM 公钥，须保留历史验签 key；通常 /run/secrets/agent/grant-public.json，本机文件放 secrets/agent/。
AGENT_GRANT_PUBLIC_KEYS_FILE=
# 模型非敏感路由修订，V2 计量身份依赖它；留空拒绝相应执行，修改须核对 Policy 能力 digest，不填密钥或真实地址。
AGENT_MODEL_ROUTE_REVISION=
# 工具非敏感配置发布修订，V2 计量身份依赖它；留空拒绝相应执行，修改须核对 Policy 能力 digest。
AGENT_TOOL_CONFIGURATION_RELEASE=

# ---- V2 用量投递（联调初值，生产需审核） ----
# 持久用量 Outbox 容量上限（条）；模板是联调初值，生产须审核容量。
AGENT_USAGE_OUTBOX_CAPACITY=10000
# Usage Worker 每批投递条数；V2 必须运行 Usage Worker。
AGENT_USAGE_BATCH_SIZE=100
# 用量投递最大尝试次数。
AGENT_USAGE_MAX_ATTEMPTS=10
# 用量投递重试基础间隔（秒）。
AGENT_USAGE_RETRY_BASE_SECONDS=2
# 用量投递重试最大间隔（秒）。
AGENT_USAGE_RETRY_MAX_SECONDS=300
# Usage Worker 轮询间隔（秒）。
AGENT_USAGE_POLL_SECONDS=2

# ---- 模型 Provider（仅在 Agent 配置） ----
# 百炼 / DashScope API Key；只在 Agent 配置，不使用该 Provider 可留空。
DASHSCOPE_API_KEY=
# DeepSeek API Key；不使用该 Provider 可留空。
DEEPSEEK_API_KEY=
# 智谱 API Key；不使用该 Provider 可留空。
ZHIPU_API_KEY=
# AutoDL API Key；不使用该 Provider 可留空。
AUTODL_API_KEY=

# ---- OpenLux ----
# OpenLux API Key；内置固定五款型号，前四款已通过基础探测，Gemini 输出上限待确认不进入 Agent。
OPENLUX_API_KEY=
# OpenLux 完整可信 HTTPS 端点，真实地址只填本地 agent.env。
# OPENLUX_BASE_URL=<OPENLUX_BASE_URL>

# ---- 模型注册与默认选择 ----
# 默认 Chat 模型，建议填写 provider/上游型号 的完整注册 ID；留空沿用 Registry 默认选择。
AI_DEFAULT_MODEL=
# 默认 Agent 模型，须具备工具调用能力；例如 openlux/<UPSTREAM_MODEL_ID>，留空沿用 Registry 默认选择。
AI_AGENT_DEFAULT_MODEL=
# 可选：自定义 Registry JSON 的容器可读路径，须另加只读挂载，不能直接填本机路径。
AI_MODEL_REGISTRY_FILE=
# 模型请求超时（秒）。
AI_TIMEOUT_SEC=90

# ---- 搜索、技能与模型行为 ----
# Tavily 搜索凭据，按所用 Provider 配置。
TAVILY_API_KEY=
# SearXNG 搜索服务地址，必须从容器可达；真实地址只填本地 env。
SEARXNG_BASE_URL=
# Exa 搜索凭据，按所用 Provider 配置。
EXA_API_KEY=
# Vendor 技能选择：空为全部启用，none 为关闭，逗号分隔名称为仅启用指定项。
SKILLS_VENDOR=
# true 时关闭适配器支持的 thinking；V2 修改后需核对模型身份 digest。
AGENT_DISABLE_THINKING=false

# ---- 可选 Provider 覆盖 ----
# 不覆盖时保持注释（未设置），不要取消注释后留空：空 BASE_URL 会覆盖内置地址。
# --from-local 仅导入非空本机覆盖值；真实地址只写本地 agent.env。
# DASHSCOPE_BASE_URL=<DASHSCOPE_BASE_URL>
# DEEPSEEK_BASE_URL=<DEEPSEEK_BASE_URL>
# ZHIPU_BASE_URL=<ZHIPU_BASE_URL>
# AUTODL_BASE_URL=<AUTODL_BASE_URL>
