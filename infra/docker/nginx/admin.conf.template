pid /tmp/admin-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    server_tokens off;
    client_body_temp_path /tmp/admin-body;
    proxy_temp_path /tmp/admin-proxy;
    fastcgi_temp_path /tmp/admin-fastcgi;
    uwsgi_temp_path /tmp/admin-uwsgi;
    scgi_temp_path /tmp/admin-scgi;
    map $http_host $valid_admin_host {
        default 0;
        "127.0.0.1:3101" 1;
        "localhost:3101" 1;
    }
    map $http_origin $valid_admin_origin {
        default 0;
        "" 1;
        "http://127.0.0.1:3101" 1;
        "http://localhost:3101" 1;
    }
    server {
        listen 3101;
        root /usr/share/nginx/html;
        if ($valid_admin_host = 0) { return 403; }
        if ($valid_admin_origin = 0) { return 403; }
        if ($http_sec_fetch_site = cross-site) { return 403; }
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;
        client_max_body_size 512k;
        location = /health { access_log off; return 200 "ok"; }
        location /api/v1/admin-console/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $http_host;
            proxy_set_header X-ShenZhi-Admin-Entry __ADMIN_ENTRY_SECRET__;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header Forwarded "";
            proxy_read_timeout 30s;
            add_header Cache-Control no-store always;
        }
        location /api/ { return 404; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
