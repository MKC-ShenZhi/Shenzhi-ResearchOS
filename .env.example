# Environment files are application-specific; do not share model/search keys with Web.
# Web: copy apps/web/.env.example to apps/web/.env.local
# Backend: copy apps/backend/.env.example to apps/backend/.env
# Load the backend file explicitly: uvicorn app.main:app --env-file .env
# See docs/chat/README.md and docs/auth/CONFIGURATION.md.
# Multi-provider LLM configuration: docs/engineering/llm-api-foundation.md (Backend only).

# The following settings belong in apps/backend/.env, never in Web / NEXT_PUBLIC_*.
# Empty key: no AutoDL registration. Base URL overrides must be HTTPS.
AUTODL_API_KEY=
AUTODL_BASE_URL=https://www.autodl.art/api/v1
# Exact upstream IDs, comma-separated; blank uses the verified list in priority order:
# DeepSeek-V4.1-Flash-1017,Qwen3.5-397B-A17B,Kimi-K2.5
AUTODL_MODELS=
# Recommended defaults when AutoDL is enabled:
# AI_DEFAULT_MODEL=autodl/DeepSeek-V4.1-Flash-1017
# AI_AGENT_DEFAULT_MODEL=autodl/DeepSeek-V4.1-Flash-1017
