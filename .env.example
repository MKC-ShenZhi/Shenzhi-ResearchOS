# Environment files are application-specific; do not share model/search keys with Web.
# Web: copy apps/web/.env.example to apps/web/.env.local
# Backend: copy apps/backend/.env.example to apps/backend/.env
# Agent: copy apps/agent/.env.example to apps/agent/.env for native launches.
# Docker Agent env_file on this machine: infra/docker/env/agent.env.
# Compose's project .env is not automatically injected into containers.
# Load the backend file explicitly: uvicorn app.main:app --env-file .env
# See docs/engineering/deployment.md and docs/auth/CONFIGURATION.md.
# Multi-provider LLM configuration: docs/engineering/llm-api-foundation.md (Agent only).

# Model credentials belong only in the Agent runtime env.
# Catalog maintains endpoints and enabled models; ordinary developers only fill keys.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
AUTODL_API_KEY=
OPENLUX_API_KEY=
# OpenLux has a fixed catalog; Gemini's output limit still needs verification.
# Optional deployment overrides/defaults are documented in apps/agent/.env.example.
