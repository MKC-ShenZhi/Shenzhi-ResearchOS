# Copy to the formal server as /opt/shenzhi/.env.ops — never commit real values.
# Webhook + sign secret: desktop webhook&key.txt
# Cron (Asia/Shanghai): 08:00 daily + */5 probe — see docs/engineering/deployment.md

OPS_LARK_WEBHOOK_URL=
OPS_LARK_SIGN_SECRET=

# Optional — leave OPS_COMPOSE_FILE empty if not using Docker Compose on host
OPS_COMPOSE_FILE=
OPS_HTTP_URL=http://127.0.0.1/
OPS_STATE_FILE=/var/lib/shenzhi/ops-alert-state.json
OPS_ALERT_MEM_AVAIL_PCT=10
OPS_ALERT_DISK_USE_PCT=90
OPS_ALERT_LOAD_FACTOR=2
OPS_ALERT_COOLDOWN_SEC=1800
OPS_HOST_LABEL=ecs-shenzhi
OPS_SOURCE_SERVICE=monitoring
OPS_SOURCE_COMPONENT=host-probe