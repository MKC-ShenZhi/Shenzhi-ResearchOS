# Copy to ECS as /opt/shenzhi/.env.ops — never commit real values.
# Webhook + sign secret: desktop webhook&key.txt

OPS_LARK_WEBHOOK_URL=
OPS_LARK_SIGN_SECRET=

# Optional
OPS_COMPOSE_FILE=/opt/shenzhi/docker-compose.yml
OPS_HTTP_URL=http://127.0.0.1/
OPS_STATE_FILE=/var/lib/shenzhi/ops-alert-state.json
OPS_ALERT_MEM_AVAIL_PCT=10
OPS_ALERT_DISK_USE_PCT=90
OPS_ALERT_LOAD_FACTOR=2
OPS_ALERT_COOLDOWN_SEC=1800
OPS_HOST_LABEL=ecs-shenzhi